## SQL Queries

### Create Tables

```sql
-- Primary ads table
CREATE TABLE snapchat_ads (
    ad_id                       VARCHAR(255) PRIMARY KEY,
    advanced_demographics       VARCHAR(255),
    age_bracket                 VARCHAR(50),
    billing_address             TEXT,
    closed_date                 TIMESTAMP,
    target_criteria_count       INT,
    number_of_ads               INT,
    pct_impressions             DECIMAL(10,6),
    targets_age                 BOOLEAN,
    targets_interests           BOOLEAN,
    targets_gender              BOOLEAN,
    targets_language            BOOLEAN,
    targets_os_type             BOOLEAN,
    targets_advanced_demo       BOOLEAN,
    targets_segments            BOOLEAN,
    location_targeting_tier     INT,         -- 0=none, 1=broad, 2=granular
    year_of_ad                  INT,
    spend_per_impression        DECIMAL(10,6),
    number_of_countries         INT,
    total_impressions           BIGINT,
    candidate_ballot_info       TEXT,
    country                     VARCHAR(100),
    creative_properties         TEXT,
    creative_url                TEXT,
    electoral_district          VARCHAR(255),
    end_date                    TIMESTAMP,
    gender_targeted             VARCHAR(20),
    impressions                 BIGINT,
    interests_targeted          TEXT,
    language_targeted           VARCHAR(100),
    location_zip_code           VARCHAR(20),
    location_type               VARCHAR(50),
    metro_area                  VARCHAR(100),
    os_type_targeted            VARCHAR(100),
    organization_name           VARCHAR(255),
    paying_advertiser_name      VARCHAR(255),
    region                      VARCHAR(100),
    segments_targeted           TEXT,
    spend                       DECIMAL(12,2),
    start_date                  TIMESTAMP,
    targets_minors              BOOLEAN,
    is_zero_spend               BOOLEAN,
    CONSTRAINT chk_spend
        CHECK (spend >= 0),
    CONSTRAINT chk_location_tier
        CHECK (location_targeting_tier IN (0, 1, 2)),
    CONSTRAINT chk_criteria_count
        CHECK (target_criteria_count BETWEEN 0 AND 10)
);

-- Pivoted targeting dimensions table (from Multiple Connections file)
CREATE TABLE snapchat_ads_targeting_pivot (
    pivot_id                    SERIAL PRIMARY KEY,
    ad_id                       VARCHAR(255) REFERENCES snapchat_ads(ad_id),
    pivot_field_name            VARCHAR(100),
    pivot_field_value           TEXT,
    organization_name           VARCHAR(255),
    paying_advertiser_name      VARCHAR(255),
    country                     VARCHAR(100),
    spend                       DECIMAL(12,2),
    impressions                 BIGINT,
    start_date                  TIMESTAMP,
    end_date                    TIMESTAMP,
    segments                    TEXT,
    region                      VARCHAR(100)
);

-- Election enrichment table (from Overtime data file)
CREATE TABLE snapchat_ads_overtime (
    overtime_id                 SERIAL PRIMARY KEY,
    ad_id                       VARCHAR(255) REFERENCES snapchat_ads(ad_id),
    pivot_field_name            VARCHAR(50),
    pivot_field_value           TIMESTAMP,
    election_type_2018          VARCHAR(100),
    election_type_2019          VARCHAR(100),
    election_date_2018          DATE,
    notable_date                VARCHAR(100),
    country                     VARCHAR(100),
    organization_name           VARCHAR(255),
    spend                       DECIMAL(12,2),
    impressions                 BIGINT
);
```

