### Spend Distribution and Outlier Queries

```sql
-- Spend distribution summary including outlier detection
SELECT
    MIN(spend)                                      AS min_spend,
    PERCENTILE_CONT(0.25) WITHIN GROUP
        (ORDER BY spend)                            AS p25_spend,
    PERCENTILE_CONT(0.50) WITHIN GROUP
        (ORDER BY spend)                            AS median_spend,
    ROUND(AVG(spend), 2)                            AS avg_spend,
    PERCENTILE_CONT(0.75) WITHIN GROUP
        (ORDER BY spend)                            AS p75_spend,
    MAX(spend)                                      AS max_spend,
    COUNT(CASE WHEN spend = 0
               THEN 1 END)                          AS zero_spend_ads,
    COUNT(CASE WHEN spend > 10000
               THEN 1 END)                          AS high_spend_ads
FROM snapchat_ads;
```

```sql
-- Top 10 highest spend ads with full targeting profile
SELECT
    ad_id,
    organization_name,
    paying_advertiser_name,
    country,
    age_bracket,
    targets_minors,
    target_criteria_count,
    spend,
    impressions,
    ROUND(spend::DECIMAL / NULLIF(impressions, 0), 6)
                                                    AS spend_per_impression,
    start_date,
    end_date
FROM snapchat_ads
WHERE is_zero_spend = FALSE
ORDER BY spend DESC
LIMIT 10;
