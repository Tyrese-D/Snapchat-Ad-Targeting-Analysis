### Audience Segmentation Queries

```sql
-- Percentage of ads using each targeting dimension
SELECT
    ROUND(SUM(CASE WHEN targets_age = TRUE
                   THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2)
                                                    AS pct_age_targeting,
    ROUND(SUM(CASE WHEN targets_segments = TRUE
                   THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2)
                                                    AS pct_segment_targeting,
    ROUND(SUM(CASE WHEN targets_language = TRUE
                   THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2)
                                                    AS pct_language_targeting,
    ROUND(SUM(CASE WHEN targets_interests = TRUE
                   THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2)
                                                    AS pct_interest_targeting,
    ROUND(SUM(CASE WHEN targets_gender = TRUE
                   THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2)
                                                    AS pct_gender_targeting,
    ROUND(SUM(CASE WHEN targets_advanced_demo = TRUE
                   THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2)
                                                    AS pct_advanced_demo_targeting
FROM snapchat_ads;
```

```sql
-- Targeting criteria count distribution
SELECT
    target_criteria_count,
    COUNT(ad_id)                                    AS number_of_ads,
    ROUND(COUNT(ad_id) * 100.0 / SUM(COUNT(ad_id)) OVER (), 2)
                                                    AS pct_of_total
FROM snapchat_ads
GROUP BY target_criteria_count
ORDER BY target_criteria_count ASC;
```

