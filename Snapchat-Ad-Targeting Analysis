### Country Analysis

```sql
-- Number of ads and total spend by country (country bar chart)
SELECT
    country,
    COUNT(ad_id)                                    AS number_of_ads,
    SUM(spend)                                      AS total_spend,
    SUM(impressions)                                AS total_impressions,
    ROUND(SUM(spend) * 100.0 /
        SUM(SUM(spend)) OVER (), 2)                 AS pct_of_total_spend
FROM snapchat_ads
WHERE is_zero_spend = FALSE
GROUP BY country
ORDER BY number_of_ads DESC;
```

```sql
-- Top 10 organizations by spend in the United States
SELECT
    organization_name,
    paying_advertiser_name,
    COUNT(ad_id)                                    AS number_of_ads,
    SUM(spend)                                      AS total_spend,
    SUM(impressions)                                AS total_impressions
FROM snapchat_ads
WHERE country = 'United States'
  AND is_zero_spend = FALSE
GROUP BY organization_name, paying_advertiser_name
ORDER BY total_spend DESC
LIMIT 10;
```

```sql
-- Top 10 organizations by spend in the United Kingdom
SELECT
    organization_name,
    paying_advertiser_name,
    COUNT(ad_id)                                    AS number_of_ads,
    SUM(spend)                                      AS total_spend,
    SUM(impressions)                                AS total_impressions
FROM snapchat_ads
WHERE country = 'United Kingdom'
  AND is_zero_spend = FALSE
GROUP BY organization_name, paying_advertiser_name
ORDER BY total_spend DESC
LIMIT 10;
```

