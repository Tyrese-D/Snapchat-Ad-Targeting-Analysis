### Minor Targeting Queries

```sql
-- All ads targeting users under 18
SELECT
    ad_id,
    age_bracket,
    organization_name,
    paying_advertiser_name,
    country,
    spend,
    impressions,
    start_date,
    end_date
FROM snapchat_ads
WHERE targets_minors = TRUE
ORDER BY spend DESC;
```

```sql
-- Total spend and impressions directed at minor-inclusive audiences
SELECT
    targets_minors,
    COUNT(ad_id)                                    AS number_of_ads,
    SUM(spend)                                      AS total_spend,
    SUM(impressions)                                AS total_impressions,
    ROUND(SUM(spend) * 100.0 /
        SUM(SUM(spend)) OVER (), 2)                 AS pct_of_total_spend
FROM snapchat_ads
WHERE is_zero_spend = FALSE
GROUP BY targets_minors;
```

```sql
-- Organizations that targeted minors and their total spend
SELECT
    organization_name,
    paying_advertiser_name,
    country,
    COUNT(ad_id)                                    AS minor_targeted_ads,
    SUM(spend)                                      AS total_spend,
    SUM(impressions)                                AS total_impressions,
    STRING_AGG(DISTINCT age_bracket, ', ')          AS age_brackets_used
FROM snapchat_ads
WHERE targets_minors = TRUE
  AND is_zero_spend = FALSE
GROUP BY organization_name, paying_advertiser_name, country
ORDER BY total_spend DESC;
```

