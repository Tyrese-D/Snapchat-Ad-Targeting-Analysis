### Seasonal & Election Period Queries

```sql
-- Ad volume and spend by month (seasonal trend)
SELECT
    DATE_TRUNC('month', start_date)                 AS ad_month,
    COUNT(ad_id)                                    AS number_of_ads,
    SUM(spend)                                      AS total_spend,
    SUM(impressions)                                AS total_impressions
FROM snapchat_ads
WHERE is_zero_spend = FALSE
GROUP BY DATE_TRUNC('month', start_date)
ORDER BY ad_month ASC;
```

```sql
-- Ad volume before vs after elections by country (overtime enrichment)
SELECT
    o.country,
    o.election_type_2018,
    o.election_type_2019,
    COUNT(DISTINCT o.ad_id)                         AS number_of_ads,
    SUM(a.spend)                                    AS total_spend,
    SUM(a.impressions)                              AS total_impressions
FROM snapchat_ads_overtime o
JOIN snapchat_ads a ON o.ad_id = a.ad_id
WHERE o.pivot_field_name = 'StartDate'
GROUP BY o.country, o.election_type_2018, o.election_type_2019
ORDER BY total_spend DESC;
```

```sql
-- Running cumulative spend over time per country (seasonal trend line)
SELECT
    country,
    DATE_TRUNC('week', start_date)                  AS ad_week,
    SUM(spend)                                      AS weekly_spend,
    SUM(SUM(spend)) OVER (
        PARTITION BY country
        ORDER BY DATE_TRUNC('week', start_date)
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    )                                               AS running_total_spend
FROM snapchat_ads
WHERE is_zero_spend = FALSE
GROUP BY country, DATE_TRUNC('week', start_date)
ORDER BY country, ad_week;
```

